---
import Icon from './Icon.astro';

interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Você está em">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? (
            <>
              <a href={item.href}>{item.label}</a>
              <Icon name="chevron-right" />
            </>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }

  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .crumbs svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .crumbs span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 40ch;
  }
</style>
